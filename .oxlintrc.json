{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "React": "readonly",
    "JSX": "readonly",
    "google": "readonly",
    "i": "readonly",
    "idx": "readonly"
  },
  "plugins": ["react", "oxc"],
  "rules": {
    "no-undef": ["error", { "typeof": false }],
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
