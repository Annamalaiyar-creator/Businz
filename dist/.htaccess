<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow Node.js API requests to pass straight through
  RewriteRule ^api/(.*)$ - [L]

  # Redirect all frontend routes to index.html for React SPA router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>
